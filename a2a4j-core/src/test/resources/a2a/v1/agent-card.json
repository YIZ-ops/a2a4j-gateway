{
  "name": "Gateway Test Agent",
  "description": "A minimal A2A 1.0 agent used by protocol contract tests.",
  "supportedInterfaces": [
    {
      "url": "https://agent.example.test/a2a/jsonrpc",
      "protocolBinding": "JSONRPC",
      "protocolVersion": "1.0"
    },
    {
      "url": "https://agent.example.test/a2a/http",
      "protocolBinding": "HTTP+JSON",
      "protocolVersion": "1.0"
    }
  ],
  "version": "1.0.0",
  "capabilities": {
    "streaming": true,
    "pushNotifications": false,
    "extendedAgentCard": false
  },
  "defaultInputModes": ["text/plain"],
  "defaultOutputModes": ["text/plain"],
  "skills": [
    {
      "id": "echo",
      "name": "Echo",
      "description": "Echoes a text message.",
      "tags": ["test", "text"],
      "inputModes": ["text/plain"],
      "outputModes": ["text/plain"]
    }
  ]
}
